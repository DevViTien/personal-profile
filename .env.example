# ─────────────────────────────────────────────────────────────
# Environment variables — copy file này thành .env.local rồi điền giá trị thật
#   cp .env.example .env.local   (macOS/Linux)
#   Copy-Item .env.example .env.local   (PowerShell)
#
# LƯU Ý: mọi biến NEXT_PUBLIC_* bị expose ra client (đúng bản chất EmailJS).
# KHÔNG đặt secret phía server vào biến NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────

# EmailJS — cấu hình form liên hệ. Lấy tại https://www.emailjs.com/
# Chi tiết: docs/EMAILJS_SETUP.md
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_pw_feedback
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
NEXT_PUBLIC_CONTACT_EMAIL=your_email@gmail.com

# Site (tùy chọn) — dùng cho metadata/SEO. Mặc định lấy từ src/config/site.ts
NEXT_PUBLIC_SITE_URL=https://profile.truongnbn.com
