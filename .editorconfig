# EditorConfig — đồng nhất code style giữa các editor: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false  # giữ 2 space cuối dòng (line break trong Markdown)

[*.{json,yml,yaml}]
indent_size = 2
